generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Reading {
  id           Int      @id @default(autoincrement())
  timestamp    DateTime @default(now())
  moisture     Decimal  @db.Decimal(5, 2) 
  ph           Decimal  @db.Decimal(4, 2)
  nitrogen     Int     
  phosphorus   Int     
  potassium    Int     
  temperature  Decimal  @db.Decimal(5, 2) 
  conductivity Decimal  @db.Decimal(10, 2)   // change later
  source       Source   @default(MOCK)
  @@map("readings")
}

enum Source {
  MOCK
  SENSOR
}